DATABASE_URL=postgresql://user:password@host:5432/stark_health
# Separate Neon branch used by integration tests (programAudit.integration.test.ts).
# Must differ from DATABASE_URL to prevent test mutations hitting the dev database.
DATABASE_URL_TEST=postgresql://user:password@host:5432/stark_health_test
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OPENAI_API_KEY=
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
# Attach caregivers by email after they sign up (comma-separated)
SEED_CAREGIVER_EMAILS=
# When true, any authenticated user without a dog is auto-attached to Stark
STARK_AUTO_ATTACH=true
AI_CARE_MODEL=gpt-4o-mini
# Exercise creation agent (LangGraph + Tavily web research)
TAVILY_API_KEY=
AI_EXERCISE_MODEL=gpt-4o-mini
# AI_EXERCISE_MAX_STEPS=12

# Dog profile photos (private S3 + presigned PUT/GET). See docs/S3_DOG_PHOTOS.md
AWS_REGION=us-east-1
S3_BUCKET_DOG_PHOTOS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_DOG_PHOTO_PREFIX=dog-photos
# S3_PRESIGN_UPLOAD_EXPIRES_SEC=900
# S3_PRESIGN_VIEW_EXPIRES_SEC=3600

# Sprite generation — per-dog custom sprite sets
# Model for OpenAI image generation (images.edit). Requires images capability.
SPRITE_IMAGE_MODEL=gpt-image-1
# Output frame size in pixels (post-processed square). Must be >= generated size.
# SPRITE_FRAME_SIZE=1245
# S3 prefix for generated sprite frames (same bucket as dog photos)
# S3_DOG_SPRITE_PREFIX=dog-sprites
# Worker tuning (longer defaults than voice notes — image gen is slow)
# SPRITE_JOB_POLL_MS=3000
# SPRITE_JOB_LEASE_MS=300000
# SPRITE_JOB_MAX_ATTEMPTS=3
