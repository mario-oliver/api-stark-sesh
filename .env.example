DATABASE_URL=postgresql://user:password@host:5432/stark_health
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OPENAI_API_KEY=
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
