// Stark Health — voice-first dog PT care tracking

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum CareActionFrequency {
  DAILY
  EVERY_OTHER_DAY
  WEEKLY
  AS_NEEDED
}

enum CareActionTimeOfDay {
  MORNING
  EVENING
  ANYTIME
}

// Execution context under Vicky's plan (ADR-0004) — NOT a second taxonomy;
// `bucket` (CareBucket) stays the one taxonomy of what an action IS.
enum CareActionTier {
  CORE
  ROUTINE
  ON_WALKS
  AS_NEEDED
}

enum DailyCareActionStatus {
  PENDING
  COMPLETED
  SKIPPED
  PARTIALLY_COMPLETED
  UNCLEAR
}

enum Tolerance {
  GOOD
  OKAY
  POOR
  PAINFUL
  UNKNOWN
}

enum VoiceNoteProcessingStatus {
  PENDING
  TRANSCRIBED
  PROCESSED
  FAILED
}

enum VoiceNoteJobStatus {
  PENDING
  RUNNING
  RETRY
  COMPLETED
  FAILED
}

enum HealthObservationType {
  SLIPPING
  LIMPING
  WEAKNESS
  STIFFNESS
  PAIN
  LOW_ENERGY
  APPETITE
  BATHROOM
  GENERAL_NOTE
}

enum ObservationSeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum DogSex {
  MALE
  FEMALE
  UNKNOWN
}

enum CareAgentSessionKind {
  DAILY_LOG
  PLAN_BUILD
  PLAN_AUDIT
}

enum CareAgentSessionStatus {
  ACTIVE
  AWAITING_INPUT
  DRAFT_READY
  COMMITTED
  FAILED
}

enum CareBucket {
  ACTIVITY
  MOBILITY
  RECOVERY
}

enum DailyCareActionSource {
  PLAN
  AD_HOC
  LLM_EXTRACTED
  PLAN_VARIATION
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
  none
}

enum SubscriptionSource {
  stripe
  apple
}

model User {
  id               String   @id
  email            String   @unique
  firstName        String?
  lastName         String?
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions              Subscription[]
  dogMembers                 DogMember[]
  completedDailyActions      DailyCareAction[]      @relation("DailyCareActionCompletedBy")
  voiceNotes                 VoiceNote[]
  healthObservations         HealthObservation[]

  @@index([id])
  @@index([email])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  status            SubscriptionStatus
  planSlug          String
  source            SubscriptionSource
  periodEnd         DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  stripeSubId       String?            @unique
  stripePriceId     String?
  appleOriginalTxId String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId, status])
}

model Dog {
  id        String   @id @default(uuid())
  name      String
  breed     String?
  age       Int?
  sex       DogSex?
  weightLbs Float?
  condition String?
  vetName   String?
  vetPhone  String?
  photoKey  String?
  notes     String?
  shareCode String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                   DogMember[]
  carePlans                 CarePlan[]
  dailyCareLogs             DailyCareLog[]
  voiceNotes                VoiceNote[]
  healthObservations        HealthObservation[]
  careAgentSessions         CareAgentSession[]
  spriteSets                SpriteSet[]
  spriteGenerationSessions  SpriteGenerationSession[]

  @@index([name])
}

model DogMember {
  id        String   @id @default(uuid())
  dogId     String
  userId    String
  role      String?
  createdAt DateTime @default(now())

  dog  Dog  @relation(fields: [dogId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dogId, userId])
  @@index([dogId])
  @@index([userId])
}

model CarePlan {
  id        String   @id @default(uuid())
  dogId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog                    Dog                @relation(fields: [dogId], references: [id], onDelete: Cascade)
  actions                CareAction[]
  committedAgentSessions CareAgentSession[] @relation("CareAgentSessionCommittedCarePlan")

  @@index([dogId])
  @@index([dogId, isActive])
}

model CareAction {
  id                     String              @id @default(uuid())
  carePlanId             String
  name                   String
  description            String?
  bucket                 CareBucket
  frequency              CareActionFrequency @default(DAILY)
  timeOfDay              CareActionTimeOfDay?
  targetReps             Int?
  targetDurationSeconds  Int?
  tier                   CareActionTier?
  daysPerWeek            Int?
  targetHoldSeconds      Int?
  targetSets             Int?
  restBetweenSetsSeconds Int?
  referenceUrl           String?
  instructions           String?
  sortOrder              Int                 @default(0)
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  carePlan               CarePlan           @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  dailyCareActions       DailyCareAction[]
  committedAgentSessions CareAgentSession[] @relation("CareAgentSessionCommittedCareAction")

  @@index([carePlanId])
  @@index([carePlanId, isActive, sortOrder])
}

model DailyCareLog {
  id                String    @id @default(uuid())
  dogId             String
  date              DateTime  @db.Date
  summary           String?
  bucketScores      Json?
  scoreComputedAt   DateTime?
  scoreInputVersion String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  dog                Dog                 @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dailyCareActions   DailyCareAction[]
  voiceNotes         VoiceNote[]
  healthObservations HealthObservation[]

  @@unique([dogId, date])
  @@index([dogId])
  @@index([date])
}

model DailyCareAction {
  id                    String                @id @default(uuid())
  dailyCareLogId        String
  careActionId          String?
  voiceNoteId           String?
  bucket                CareBucket
  source                DailyCareActionSource @default(PLAN)

  nameSnapshot          String
  descriptionSnapshot   String?
  instructionsSnapshot  String?

  status                DailyCareActionStatus @default(PENDING)
  completedAt           DateTime?
  completedByUserId     String?

  notes                 String?
  tolerance             Tolerance?
  targetReps            Int?
  actualReps            Int?
  targetDurationSeconds Int?
  actualDurationSeconds Int?

  substitutedForTaskId  String?

  metadata              Json?
  extractionConfidence  Float?
  needsReview           Boolean               @default(false)

  sortOrder             Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  dailyCareLog   DailyCareLog      @relation(fields: [dailyCareLogId], references: [id], onDelete: Cascade)
  careAction     CareAction?       @relation(fields: [careActionId], references: [id], onDelete: Cascade)
  voiceNote      VoiceNote?        @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  completedBy    User?             @relation("DailyCareActionCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  substitutedFor DailyCareAction?  @relation("ActionSubstitution", fields: [substitutedForTaskId], references: [id], onDelete: SetNull)
  substitutions  DailyCareAction[] @relation("ActionSubstitution")

  @@unique([dailyCareLogId, careActionId])
  @@index([dailyCareLogId])
  @@index([dailyCareLogId, bucket])
  @@index([careActionId])
  @@index([voiceNoteId])
  @@index([status])
  @@index([source])
}

model VoiceNote {
  id               String                    @id @default(uuid())
  dogId            String
  dailyCareLogId   String
  userId           String
  audioUrl         String?
  transcript       String                    @default("")
  processingStatus VoiceNoteProcessingStatus @default(PENDING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  dog                Dog                      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dailyCareLog       DailyCareLog             @relation(fields: [dailyCareLogId], references: [id], onDelete: Cascade)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthObservations HealthObservation[]
  dailyCareActions   DailyCareAction[]
  processingJobs     VoiceNoteProcessingJob[]
  careAgentSessions  CareAgentSession[]

  @@index([dogId])
  @@index([dailyCareLogId])
  @@index([userId])
  @@index([processingStatus])
}

model VoiceNoteProcessingJob {
  id             String             @id @default(uuid())
  voiceNoteId    String
  status         VoiceNoteJobStatus @default(PENDING)
  attempts       Int                @default(0)
  nextRunAt      DateTime           @default(now())
  leaseExpiresAt DateTime?
  lastError      String?
  payload        Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  voiceNote VoiceNote @relation(fields: [voiceNoteId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([voiceNoteId])
}

model HealthObservation {
  id             String                @id @default(uuid())
  dogId          String
  dailyCareLogId String
  userId         String
  voiceNoteId    String?
  bucket         CareBucket?
  type           HealthObservationType
  severity       ObservationSeverity?
  bodyArea       String?
  note           String
  observedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  dog          Dog          @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dailyCareLog DailyCareLog @relation(fields: [dailyCareLogId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceNote    VoiceNote?   @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)

  @@index([dogId])
  @@index([dailyCareLogId])
  @@index([userId])
  @@index([voiceNoteId])
}

// ── Conversational producer ─────────────────────────────────────────────────
// One table for ALL conversational LLM flows (kind discriminator). Replaces the
// two former per-agent session tables (exercise build = PLAN_BUILD, program
// audit = PLAN_AUDIT). The draft stays JSON in the session; commit turns it into
// durable rows and records the polymorphic commit FK(s). See
// context.md#CareAgentSession.
model CareAgentSession {
  id          String                 @id @default(uuid())
  dogId       String
  userId      String
  kind        CareAgentSessionKind
  status      CareAgentSessionStatus @default(ACTIVE)
  messages    Json                   @default("[]")
  questions   Json?
  draft       Json?
  voiceNoteId String?

  // Polymorphic commit FKs — set when the draft becomes durable rows.
  committedCarePlanId   String?
  committedCareActionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog                 Dog         @relation(fields: [dogId], references: [id], onDelete: Cascade)
  voiceNote           VoiceNote?  @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  committedCarePlan   CarePlan?   @relation("CareAgentSessionCommittedCarePlan", fields: [committedCarePlanId], references: [id], onDelete: SetNull)
  committedCareAction CareAction? @relation("CareAgentSessionCommittedCareAction", fields: [committedCareActionId], references: [id], onDelete: SetNull)

  @@index([dogId])
  @@index([dogId, userId])
  @@index([dogId, kind])
  @@index([status])
  @@index([voiceNoteId])
}

// ── Sprite Generation ──────────────────────────────────────────────────────────

enum SpriteGenerationStatus {
  PENDING
  RUNNING
  AWAITING_INPUT
  COMPLETED
  FAILED
  CANCELED
}

enum SpriteGenStep {
  NORMALIZE_INPUT
  BUILD_BASE_REFERENCE
  GENERATE_FRAMES
  POST_PROCESS
  VALIDATE
  UPLOAD
  FINALIZE
}

enum SpriteGenJobStatus {
  PENDING
  RUNNING
  RETRY
  COMPLETED
  FAILED
}

model SpriteSet {
  id             String   @id @default(uuid())
  dogId          String
  userId         String
  status         SpriteGenerationStatus @default(COMPLETED)
  storagePrefix  String
  manifest       Json
  styleVersion   String   @default("v1")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dog                   Dog                    @relation(fields: [dogId], references: [id], onDelete: Cascade)
  generationSessions    SpriteGenerationSession[]

  @@index([dogId, isActive])
  @@index([dogId])
}

model SpriteGenerationSession {
  id               String                 @id @default(uuid())
  dogId            String
  userId           String
  status           SpriteGenerationStatus @default(PENDING)
  sourcePhotoKey   String
  breedInput       String
  normalizedBreed  String?
  prompt           String?
  currentStep      SpriteGenStep?
  steps            Json                   @default("{}")
  progress         Float                  @default(0)
  spriteSetId      String?
  error            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  dog       Dog        @relation(fields: [dogId], references: [id], onDelete: Cascade)
  spriteSet SpriteSet? @relation(fields: [spriteSetId], references: [id], onDelete: SetNull)
  jobs      SpriteGenerationJob[]

  @@index([dogId])
  @@index([dogId, userId])
  @@index([status])
}

model SpriteGenerationJob {
  id             String             @id @default(uuid())
  sessionId      String
  status         SpriteGenJobStatus @default(PENDING)
  attempts       Int                @default(0)
  nextRunAt      DateTime           @default(now())
  leaseExpiresAt DateTime?
  lastError      String?
  payload        Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  session SpriteGenerationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([sessionId])
}

