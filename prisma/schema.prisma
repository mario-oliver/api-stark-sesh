// Stark Health — voice-first dog PT care tracking

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum CareActionCategory {
  STRETCH
  STRENGTH
  MOBILITY
  WALK
  MEDICATION
  GENERAL_CARE
  OBSERVATION_CHECKPOINT
}

enum CareActionFrequency {
  DAILY
  EVERY_OTHER_DAY
  WEEKLY
  AS_NEEDED
}

enum CareActionTimeOfDay {
  MORNING
  EVENING
  ANYTIME
}

enum DailyCareActionStatus {
  PENDING
  COMPLETED
  SKIPPED
  PARTIALLY_COMPLETED
  UNCLEAR
}

enum Tolerance {
  GOOD
  OKAY
  POOR
  PAINFUL
  UNKNOWN
}

enum VoiceNoteProcessingStatus {
  PENDING
  TRANSCRIBED
  PROCESSED
  FAILED
}

enum VoiceNoteJobStatus {
  PENDING
  RUNNING
  RETRY
  COMPLETED
  FAILED
}

enum HealthObservationType {
  SLIPPING
  LIMPING
  WEAKNESS
  STIFFNESS
  PAIN
  LOW_ENERGY
  APPETITE
  BATHROOM
  MEDICATION
  GENERAL_NOTE
}

enum ObservationSeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum DogSex {
  MALE
  FEMALE
  UNKNOWN
}

enum ExerciseAgentSessionStatus {
  ACTIVE
  AWAITING_INPUT
  DRAFT_READY
  COMMITTED
  FAILED
}

enum CareBucket {
  ACTIVITY
  MOBILITY
  RECOVERY
}

enum DailyTaskSource {
  PLAN
  AD_HOC
  LLM_EXTRACTED
  PLAN_VARIATION
}

enum DailyTaskStatus {
  PENDING
  COMPLETED
  SKIPPED
  PARTIALLY_COMPLETED
  UNCLEAR
}

model User {
  id        String   @id
  email     String   @unique
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dogMembers                 DogMember[]
  completedDailyActions      DailyCareAction[]      @relation("DailyCareActionCompletedBy")
  completedDailyActionSteps  DailyCareActionStep[]  @relation("DailyCareActionStepCompletedBy")
  completedDailyTasks        DailyTask[]            @relation("DailyTaskCompletedBy")
  voiceNotes                 VoiceNote[]
  healthObservations         HealthObservation[]

  @@index([id])
  @@index([email])
}

model Dog {
  id        String   @id @default(uuid())
  name      String
  breed     String?
  age       Int?
  sex       DogSex?
  weightLbs Float?
  condition String?
  vetName   String?
  vetPhone  String?
  photoKey  String?
  notes     String?
  shareCode String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                DogMember[]
  carePlans              CarePlan[]
  dailyCareLogs          DailyCareLog[]
  voiceNotes             VoiceNote[]
  healthObservations     HealthObservation[]
  exerciseAgentSessions  ExerciseAgentSession[]

  @@index([name])
}

model DogMember {
  id        String   @id @default(uuid())
  dogId     String
  userId    String
  role      String?
  createdAt DateTime @default(now())

  dog  Dog  @relation(fields: [dogId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dogId, userId])
  @@index([dogId])
  @@index([userId])
}

model CarePlan {
  id        String   @id @default(uuid())
  dogId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog     Dog          @relation(fields: [dogId], references: [id], onDelete: Cascade)
  actions CareAction[]

  @@index([dogId])
  @@index([dogId, isActive])
}

model CareAction {
  id                     String              @id @default(uuid())
  carePlanId             String
  name                   String
  description            String?
  category               CareActionCategory
  bucket                   CareBucket?
  frequency              CareActionFrequency @default(DAILY)
  timeOfDay              CareActionTimeOfDay?
  targetReps             Int?
  targetDurationSeconds  Int?
  instructions           String?
  sortOrder              Int                 @default(0)
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  carePlan          CarePlan          @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  steps             CareActionStep[]
  dailyCareActions  DailyCareAction[]

  @@index([carePlanId])
  @@index([carePlanId, isActive, sortOrder])
}

model CareActionStep {
  id                    String      @id @default(uuid())
  careActionId          String
  name                  String
  bucket                CareBucket?
  description           String?
  instructions          String?
  targetReps            Int?
  targetDurationSeconds Int?
  mediaKey              String?
  mediaContentType      String?
  sortOrder             Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  careAction            CareAction            @relation(fields: [careActionId], references: [id], onDelete: Cascade)
  dailyCareActionSteps  DailyCareActionStep[]

  @@index([careActionId])
  @@index([careActionId, isActive, sortOrder])
}

model DailyCareLog {
  id                String    @id @default(uuid())
  dogId             String
  date              DateTime  @db.Date
  summary           String?
  bucketScores      Json?
  scoreComputedAt   DateTime?
  scoreInputVersion String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  dog                Dog                 @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dailyCareActions   DailyCareAction[]
  dailyTasks         DailyTask[]
  voiceNotes         VoiceNote[]
  healthObservations HealthObservation[]

  @@unique([dogId, date])
  @@index([dogId])
  @@index([date])
}

model DailyCareAction {
  id                String                @id @default(uuid())
  dailyCareLogId    String
  careActionId      String
  nameSnapshot      String
  categorySnapshot  CareActionCategory
  status            DailyCareActionStatus @default(PENDING)
  completedAt       DateTime?
  completedByUserId String?
  notes                    String?
  tolerance                Tolerance?
  issueObserved            Boolean               @default(false)
  targetReps               Int?
  targetDurationSeconds    Int?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  dailyCareLog DailyCareLog          @relation(fields: [dailyCareLogId], references: [id], onDelete: Cascade)
  careAction   CareAction            @relation(fields: [careActionId], references: [id], onDelete: Cascade)
  completedBy  User?                 @relation("DailyCareActionCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  steps        DailyCareActionStep[]

  @@unique([dailyCareLogId, careActionId])
  @@index([dailyCareLogId])
  @@index([careActionId])
  @@index([status])
}

model DailyCareActionStep {
  id                    String                @id @default(uuid())
  dailyCareActionId     String
  careActionStepId      String
  nameSnapshot          String
  targetReps            Int?
  targetDurationSeconds Int?
  status                DailyCareActionStatus @default(PENDING)
  completedAt           DateTime?
  completedByUserId     String?
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  dailyCareAction DailyCareAction @relation(fields: [dailyCareActionId], references: [id], onDelete: Cascade)
  careActionStep  CareActionStep  @relation(fields: [careActionStepId], references: [id], onDelete: Cascade)
  completedBy     User?           @relation("DailyCareActionStepCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([dailyCareActionId, careActionStepId])
  @@index([dailyCareActionId])
  @@index([careActionStepId])
  @@index([status])
}

model VoiceNote {
  id               String                    @id @default(uuid())
  dogId            String
  dailyCareLogId   String
  userId           String
  audioUrl         String?
  transcript       String                    @default("")
  processingStatus VoiceNoteProcessingStatus @default(PENDING)
  extraction       Json?
  caregiverNote    String?
  needsReview      Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  dog                Dog                      @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dailyCareLog       DailyCareLog             @relation(fields: [dailyCareLogId], references: [id], onDelete: Cascade)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthObservations HealthObservation[]
  processingJobs     VoiceNoteProcessingJob[]

  @@index([dogId])
  @@index([dailyCareLogId])
  @@index([userId])
  @@index([processingStatus])
}

model VoiceNoteProcessingJob {
  id             String             @id @default(uuid())
  voiceNoteId    String
  status         VoiceNoteJobStatus @default(PENDING)
  attempts       Int                @default(0)
  nextRunAt      DateTime           @default(now())
  leaseExpiresAt DateTime?
  lastError      String?
  payload        Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  voiceNote VoiceNote @relation(fields: [voiceNoteId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([voiceNoteId])
}

model HealthObservation {
  id             String                @id @default(uuid())
  dogId          String
  dailyCareLogId String
  userId         String
  voiceNoteId    String?
  bucket         CareBucket?
  type           HealthObservationType
  severity       ObservationSeverity?
  bodyArea       String?
  note           String
  observedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  dog          Dog          @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dailyCareLog DailyCareLog @relation(fields: [dailyCareLogId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceNote    VoiceNote?   @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)

  @@index([dogId])
  @@index([dailyCareLogId])
  @@index([userId])
  @@index([voiceNoteId])
}

model DailyTask {
  id                    String          @id @default(uuid())
  dailyCareLogId        String
  bucket                CareBucket
  source                DailyTaskSource @default(PLAN)

  nameSnapshot          String
  descriptionSnapshot   String?
  instructionsSnapshot  String?

  status                DailyTaskStatus @default(PENDING)
  completedAt           DateTime?
  completedByUserId     String?

  notes                 String?
  targetReps            Int?
  actualReps            Int?
  targetDurationSeconds Int?
  actualDurationSeconds Int?

  careActionId          String?
  careActionStepId      String?
  substitutedForTaskId  String?

  metadata              Json?
  extractionConfidence  Float?
  needsReview           Boolean         @default(false)

  sortOrder             Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  dailyCareLog   DailyCareLog @relation(fields: [dailyCareLogId], references: [id], onDelete: Cascade)
  completedBy    User?        @relation("DailyTaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  substitutedFor DailyTask?   @relation("TaskSubstitution", fields: [substitutedForTaskId], references: [id], onDelete: SetNull)
  substitutions  DailyTask[]  @relation("TaskSubstitution")

  @@index([dailyCareLogId])
  @@index([dailyCareLogId, bucket])
  @@index([status])
  @@index([source])
  @@index([careActionId])
  @@index([careActionStepId])
}

model ExerciseAgentSession {
  id        String                     @id @default(uuid())
  dogId     String
  userId    String
  status    ExerciseAgentSessionStatus @default(ACTIVE)
  messages  Json                       @default("[]")
  draft     Json?
  research  Json?
  questions Json?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId])
  @@index([dogId, userId])
  @@index([status])
}
